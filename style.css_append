/* Star Rating Component */
.star-rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 4px;
}

.star-rating input {
    display: none;
}

.star-rating label {
    font-size: 1.5rem;
    color: #cbd5e0;
    cursor: pointer;
    transition: color 0.2s;
}

.star-rating input:checked ~ label,
.star-rating label:hover,
.star-rating label:hover ~ label {
    color: #F6E05E; /* Star Yellow */
}

/* Badge Styles for Trip Types */
.badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-block;
}

.badge-purple { background: #E9D8FD; color: #6B46C1; } /* Luxury */
.badge-green { background: #F0FFF4; color: #2F855A; } /* Adventure */
.badge-blue { background: #EBF8FF; color: #2C5282; } /* Educational */
.badge-orange { background: #FEEBC8; color: #C05621; } /* Leisure */
.badge-gray { background: #EDF2F7; color: #4A5568; } /* General */
