/* Media Section Improvements */
.media-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    background: #f8fafc;
    padding: 10px;
    border-radius: 12px;
}

.media-actions {
    display: flex;
    gap: 10px;
}

.btn-icon {
    padding: 8px 12px;
    font-size: 1rem;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
    color: var(--secondary-color);
}

.btn-icon:hover {
    background: #edf2f7;
    border-color: #cbd5e0;
}

.btn-icon.danger {
    color: #e53e3e;
    border-color: #feb2b2;
}

.btn-icon.danger:hover {
    background: #fff5f5;
}

.upload-panel {
    display: none;
    background: #f7fafc;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    border: 1px solid #edf2f7;
    animation: fadeIn 0.3s ease;
}

.upload-panel.active {
    display: block;
}

.media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 16px;
}

.media-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
    background: #f1f5f9;
}

.media-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.media-card.selected {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.2);
}

.media-checkbox {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    width: 18px;
    height: 18px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
    accent-color: var(--primary-color);
}

.media-card:hover .media-checkbox,
.media-card.selected .media-checkbox {
    opacity: 1;
}

.media-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.media-icon-preview {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-light);
    background: #edf2f7;
}

.media-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(0,0,0,0.6);
    color: white;
    padding: 4px;
    font-size: 0.7rem;
    text-align: center;
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.2s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.media-card:hover .media-info {
    opacity: 1;
}

/* Tabs override for media toolbar */
.media-controls .tabs {
    background: none;
    padding: 0;
    margin: 0;
    box-shadow: none;
    gap: 8px;
}
.media-controls .tab-btn {
    padding: 6px 12px;
    font-size: 0.9rem;
    background: transparent;
    border: none;
    color: var(--text-light);
    border-radius: 20px;
}
.media-controls .tab-btn.active {
    background: var(--white);
    color: var(--primary-color);
    box-shadow: var(--shadow-sm);
    font-weight: 600;
}
